{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:onboarding:credential-csr-submission:v1",
  "title": "Device credential CSR submission v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "urn:algaguard:schema:onboarding:credential-csr-submission:v1" },
    "schemaVersion": { "const": "1.0.0" },
    "deviceUuid": { "type": "string", "format": "uuid" },
    "deviceId": { "$ref": "urn:algaguard:schema:common:device-reference:v1#/$defs/deviceId" },
    "purpose": { "type": "string", "enum": ["INITIAL", "ROTATION", "RECOVERY"] },
    "rotationId": { "type": ["string", "null"], "format": "uuid" },
    "idempotencyKey": { "type": "string", "format": "uuid" },
    "keyAlgorithm": { "type": "string", "enum": ["EC_P256", "RSA_3072"] },
    "csrPem": {
      "type": "string",
      "minLength": 128,
      "maxLength": 16384,
      "pattern": "^-----BEGIN CERTIFICATE REQUEST-----[\\s\\S]+-----END CERTIFICATE REQUEST-----\\n?$"
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "deviceUuid",
    "deviceId",
    "purpose",
    "rotationId",
    "idempotencyKey",
    "keyAlgorithm",
    "csrPem"
  ]
}
