{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:onboarding:credential-revocation-status:v1",
  "title": "Device credential revocation status v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "urn:algaguard:schema:onboarding:credential-revocation-status:v1" },
    "schemaVersion": { "const": "1.0.0" },
    "credentialId": { "type": "string", "format": "uuid" },
    "deviceUuid": { "type": "string", "format": "uuid" },
    "deviceId": { "$ref": "urn:algaguard:schema:common:device-reference:v1#/$defs/deviceId" },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "ROTATING", "REVOKED", "EXPIRED", "COMPROMISED", "FAILED"]
    },
    "revokedAt": { "type": ["string", "null"], "format": "date-time" },
    "revocationReason": {
      "$ref": "urn:algaguard:schema:onboarding:device-credential-metadata:v1#/$defs/revocationReason"
    },
    "effectiveWithinSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": [
    "schema",
    "schemaVersion",
    "credentialId",
    "deviceUuid",
    "deviceId",
    "status",
    "revokedAt",
    "revocationReason",
    "effectiveWithinSeconds",
    "updatedAt"
  ]
}
