{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:onboarding:device-credential-metadata:v1",
  "title": "Device credential metadata v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "nullableTimestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "nullableUuid": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "credentialStatus": {
      "type": "string",
      "enum": ["PENDING", "ACTIVE", "ROTATING", "REVOKED", "EXPIRED", "COMPROMISED", "FAILED"]
    },
    "revocationReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ROTATED",
            "EXPIRED",
            "COMPROMISED",
            "ADMIN_REVOKED",
            "DEVICE_RETIRED",
            "ISSUANCE_ERROR",
            "RECOVERY_REPLACED"
          ]
        },
        { "type": "null" }
      ]
    }
  },
  "properties": {
    "schema": { "const": "urn:algaguard:schema:onboarding:device-credential-metadata:v1" },
    "schemaVersion": { "const": "1.0.0" },
    "credentialId": { "type": "string", "format": "uuid" },
    "deviceUuid": { "type": "string", "format": "uuid" },
    "deviceId": { "$ref": "urn:algaguard:schema:common:device-reference:v1#/$defs/deviceId" },
    "certificateSerial": { "type": ["string", "null"], "pattern": "^[0-9A-F]{2,80}$" },
    "fingerprintSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "certificatePem": {
      "type": ["string", "null"],
      "minLength": 128,
      "maxLength": 16384,
      "pattern": "^-----BEGIN CERTIFICATE-----[\\s\\S]+-----END CERTIFICATE-----\\n?$"
    },
    "issuerDistinguishedName": { "type": ["string", "null"], "minLength": 1, "maxLength": 1024 },
    "subjectDistinguishedName": { "type": ["string", "null"], "minLength": 1, "maxLength": 1024 },
    "sanUris": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^urn:algaguard:device:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "notBefore": { "type": ["string", "null"], "format": "date-time" },
    "notAfter": { "type": ["string", "null"], "format": "date-time" },
    "issuedAt": { "type": ["string", "null"], "format": "date-time" },
    "activatedAt": { "$ref": "#/$defs/nullableTimestamp" },
    "revokedAt": { "$ref": "#/$defs/nullableTimestamp" },
    "revocationReason": { "$ref": "#/$defs/revocationReason" },
    "status": { "$ref": "#/$defs/credentialStatus" },
    "parentCredentialId": { "$ref": "#/$defs/nullableUuid" },
    "childCredentialId": { "$ref": "#/$defs/nullableUuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": [
    "schema",
    "schemaVersion",
    "credentialId",
    "deviceUuid",
    "deviceId",
    "certificateSerial",
    "fingerprintSha256",
    "certificatePem",
    "issuerDistinguishedName",
    "subjectDistinguishedName",
    "sanUris",
    "notBefore",
    "notAfter",
    "issuedAt",
    "activatedAt",
    "revokedAt",
    "revocationReason",
    "status",
    "parentCredentialId",
    "childCredentialId",
    "createdAt",
    "updatedAt"
  ]
}
