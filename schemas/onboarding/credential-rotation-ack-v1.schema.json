{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:onboarding:credential-rotation-ack:v1",
  "title": "Device credential rotation acknowledgement v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "urn:algaguard:schema:onboarding:credential-rotation-ack:v1" },
    "schemaVersion": { "const": "1.0.0" },
    "rotationId": { "type": "string", "format": "uuid" },
    "deviceUuid": { "type": "string", "format": "uuid" },
    "deviceId": { "$ref": "urn:algaguard:schema:common:device-reference:v1#/$defs/deviceId" },
    "newCredentialId": { "type": "string", "format": "uuid" },
    "result": { "type": "string", "enum": ["CONNECTED", "FAILED"] },
    "connectedAt": { "type": ["string", "null"], "format": "date-time" },
    "acknowledgedAt": { "type": "string", "format": "date-time" },
    "failureCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "TLS_REJECTED",
            "BROKER_UNREACHABLE",
            "STORAGE_FAILURE",
            "TIME_UNSYNCHRONIZED",
            "UNKNOWN"
          ]
        },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "rotationId",
    "deviceUuid",
    "deviceId",
    "newCredentialId",
    "result",
    "connectedAt",
    "acknowledgedAt",
    "failureCode"
  ]
}
