{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:onboarding:credential-rotation-request:v1",
  "title": "Device credential rotation request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "urn:algaguard:schema:onboarding:credential-rotation-request:v1" },
    "schemaVersion": { "const": "1.0.0" },
    "rotationId": { "type": "string", "format": "uuid" },
    "deviceUuid": { "type": "string", "format": "uuid" },
    "deviceId": { "$ref": "urn:algaguard:schema:common:device-reference:v1#/$defs/deviceId" },
    "currentCredentialId": { "type": "string", "format": "uuid" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "overlapSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
    "reason": { "type": "string", "enum": ["SCHEDULED", "EXPIRING", "ADMIN_REQUESTED", "RECOVERY"] }
  },
  "required": [
    "schema",
    "schemaVersion",
    "rotationId",
    "deviceUuid",
    "deviceId",
    "currentCredentialId",
    "requestedAt",
    "expiresAt",
    "overlapSeconds",
    "reason"
  ]
}
