{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:onboarding:credential-health:v1",
  "title": "Device credential health projection v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "urn:algaguard:schema:onboarding:credential-health:v1" },
    "schemaVersion": { "const": "1.0.0" },
    "deviceUuid": { "type": "string", "format": "uuid" },
    "deviceId": { "$ref": "urn:algaguard:schema:common:device-reference:v1#/$defs/deviceId" },
    "observedAt": { "type": "string", "format": "date-time" },
    "credentialStatus": {
      "$ref": "urn:algaguard:schema:onboarding:device-credential-metadata:v1#/$defs/credentialStatus"
    },
    "activeCredentialId": { "type": ["string", "null"], "format": "uuid" },
    "certificateExpiresAt": { "type": ["string", "null"], "format": "date-time" },
    "rotationRequired": { "type": "boolean" },
    "brokerAuthentication": { "type": "string", "enum": ["VALID", "REJECTED", "UNKNOWN"] },
    "recoveryRequired": { "type": "boolean" }
  },
  "required": [
    "schema",
    "schemaVersion",
    "deviceUuid",
    "deviceId",
    "observedAt",
    "credentialStatus",
    "activeCredentialId",
    "certificateExpiresAt",
    "rotationRequired",
    "brokerAuthentication",
    "recoveryRequired"
  ]
}
