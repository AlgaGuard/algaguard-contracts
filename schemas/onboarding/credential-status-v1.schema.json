{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:onboarding:credential-status:v1",
  "title": "Device credential lifecycle status v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "urn:algaguard:schema:onboarding:credential-status:v1" },
    "schemaVersion": { "const": "1.0.0" },
    "deviceUuid": { "type": "string", "format": "uuid" },
    "deviceId": { "$ref": "urn:algaguard:schema:common:device-reference:v1#/$defs/deviceId" },
    "lifecycleStatus": {
      "$ref": "urn:algaguard:schema:onboarding:device-credential-metadata:v1#/$defs/credentialStatus"
    },
    "activeCredentialIds": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "rotationId": { "type": ["string", "null"], "format": "uuid" },
    "rotationExpiresAt": { "type": ["string", "null"], "format": "date-time" },
    "recoveryRequired": { "type": "boolean" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": [
    "schema",
    "schemaVersion",
    "deviceUuid",
    "deviceId",
    "lifecycleStatus",
    "activeCredentialIds",
    "rotationId",
    "rotationExpiresAt",
    "recoveryRequired",
    "updatedAt"
  ]
}
