{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:onboarding:credential-issuance:v1",
  "title": "Device credential issuance response v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "urn:algaguard:schema:onboarding:credential-issuance:v1" },
    "schemaVersion": { "const": "1.0.0" },
    "credential": { "$ref": "urn:algaguard:schema:onboarding:device-credential-metadata:v1" },
    "caChainPem": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 128,
        "maxLength": 16384,
        "pattern": "^-----BEGIN CERTIFICATE-----[\\s\\S]+-----END CERTIFICATE-----\\n?$"
      }
    },
    "broker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "serverName": { "type": "string", "minLength": 1, "maxLength": 253 },
        "tlsRequired": { "const": true },
        "keepAliveSeconds": { "type": "integer", "minimum": 15, "maximum": 3600 },
        "sessionExpirySeconds": { "type": "integer", "minimum": 0, "maximum": 604800 }
      },
      "required": [
        "host",
        "port",
        "serverName",
        "tlsRequired",
        "keepAliveSeconds",
        "sessionExpirySeconds"
      ]
    }
  },
  "required": ["schema", "schemaVersion", "credential", "caChainPem", "broker"]
}
