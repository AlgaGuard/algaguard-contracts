{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:onboarding:owned-device-bootstrap-reissue-request:v1",
  "title": "Owner-authorized device bootstrap reissue request v1",
  "description": "Development/demo-only request to issue one short-lived bootstrap session for an already-owned claimed device without changing device identity or ownership.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "urn:algaguard:schema:onboarding:owned-device-bootstrap-reissue-request:v1"
    },
    "schemaVersion": { "const": "1.0.0" },
    "ownershipVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "expiresInSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 600
    }
  },
  "required": ["schema", "schemaVersion", "ownershipVersion", "expiresInSeconds"]
}
