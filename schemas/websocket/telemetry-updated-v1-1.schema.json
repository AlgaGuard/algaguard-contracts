{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:websocket:telemetry-updated:v1-1",
  "title": "Telemetry updated realtime event v1.1",
  "description": "Compatible WebSocket v1 telemetry event with explicit internal UUID, canonical device ID, and trusted organization routing context.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    }
  },
  "properties": {
    "schema": {
      "const": "urn:algaguard:schema:websocket:telemetry-updated:v1-1"
    },
    "schemaVersion": {
      "const": "1.1.0"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "telemetry.updated"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "organizationId": {
      "$ref": "urn:algaguard:schema:common:device-identity:v1#/$defs/organizationId"
    },
    "deviceUuid": {
      "$ref": "urn:algaguard:schema:common:device-identity:v1#/$defs/deviceUuid"
    },
    "deviceId": {
      "$ref": "urn:algaguard:schema:common:device-identity:v1#/$defs/deviceId"
    },
    "sequence": {
      "$ref": "#/$defs/sequence"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample": {
          "$ref": "urn:algaguard:schema:mqtt:telemetry-sample:v1"
        },
        "activeProfile": {
          "$ref": "urn:algaguard:schema:common:profile-reference:v1"
        }
      },
      "required": ["sample"]
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "extensions": {
      "$ref": "urn:algaguard:schema:common:extension-map:v1"
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "organizationId",
    "deviceUuid",
    "deviceId",
    "sequence",
    "payload"
  ]
}
