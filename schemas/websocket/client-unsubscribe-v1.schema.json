{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:websocket:client-unsubscribe:v1",
  "title": "Realtime client unsubscribe request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "algaguard.websocket.unsubscribe"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "subscriptionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "extensions": {
      "$ref": "urn:algaguard:schema:common:extension-map:v1"
    }
  },
  "required": ["schema", "schemaVersion", "requestId", "subscriptionIds"]
}
