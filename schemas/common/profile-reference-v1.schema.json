{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:common:profile-reference:v1",
  "title": "Immutable algae profile reference v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "profileId": {
      "type": "string",
      "format": "uuid"
    },
    "profileVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    }
  },
  "properties": {
    "profileId": {
      "$ref": "#/$defs/profileId"
    },
    "profileVersion": {
      "$ref": "#/$defs/profileVersion"
    }
  },
  "required": ["profileId", "profileVersion"]
}
