{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:common:device-identity:v1",
  "title": "Trusted device identity v1",
  "description": "Backend-owned mapping between the canonical device identity and its internal resource and organization identities.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "deviceUuid": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "$ref": "urn:algaguard:schema:common:device-reference:v1#/$defs/deviceId"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "UNCLAIMED",
        "CLAIMED",
        "PROVISIONING",
        "PROVISIONED",
        "ACTIVE",
        "INACTIVE",
        "REVOKED"
      ]
    },
    "ownershipVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "maxLength": 20
    },
    "resolvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "properties": {
    "deviceUuid": {
      "$ref": "#/$defs/deviceUuid"
    },
    "deviceId": {
      "$ref": "#/$defs/deviceId"
    },
    "organizationId": {
      "$ref": "#/$defs/organizationId"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "ownershipVersion": {
      "$ref": "#/$defs/ownershipVersion"
    },
    "resolvedAt": {
      "$ref": "#/$defs/resolvedAt"
    },
    "tankId": {
      "type": "string",
      "format": "uuid"
    },
    "contextVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "maxLength": 20
    }
  },
  "required": ["deviceUuid", "deviceId", "organizationId", "status", "ownershipVersion"]
}
