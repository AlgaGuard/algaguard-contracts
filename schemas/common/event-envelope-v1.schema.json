{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:common:event-envelope:v1",
  "title": "AlgaGuard event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^urn:algaguard:schema:[a-z0-9:-]+:v[1-9][0-9]*$",
      "maxLength": 128
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "$ref": "urn:algaguard:schema:common:device-reference:v1#/$defs/deviceId"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
      "maxLength": 55
    },
    "extensions": {
      "$ref": "urn:algaguard:schema:common:extension-map:v1"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": ["schema", "schemaVersion", "messageId", "sentAt", "payload"]
}
