{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algaguard:schema:mqtt:telemetry-batch:v1",
  "title": "Telemetry batch envelope v1",
  "description": "A normal batch contains about ten one-second samples; replay batches are bounded to 120 samples.",
  "$defs": {
    "decimalSequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    }
  },
  "allOf": [
    {
      "$ref": "urn:algaguard:schema:common:event-envelope:v1"
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "urn:algaguard:schema:mqtt:telemetry-batch:v1"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "batchId": {
              "type": "string",
              "format": "uuid"
            },
            "firstSequence": {
              "$ref": "#/$defs/decimalSequence"
            },
            "lastSequence": {
              "$ref": "#/$defs/decimalSequence"
            },
            "sampleCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            "activeProfile": {
              "$ref": "urn:algaguard:schema:common:profile-reference:v1"
            },
            "samples": {
              "type": "array",
              "minItems": 1,
              "maxItems": 120,
              "items": {
                "$ref": "urn:algaguard:schema:mqtt:telemetry-sample:v1"
              }
            },
            "isReplay": {
              "type": "boolean",
              "default": false
            },
            "createdFromSd": {
              "type": "boolean",
              "default": false
            },
            "extensions": {
              "$ref": "urn:algaguard:schema:common:extension-map:v1"
            }
          },
          "required": [
            "batchId",
            "firstSequence",
            "lastSequence",
            "sampleCount",
            "activeProfile",
            "samples"
          ]
        }
      },
      "required": ["deviceId"]
    }
  ]
}
